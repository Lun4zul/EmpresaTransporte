<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tienda.TiendaController"
            prefWidth="900" prefHeight="650"
            style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI', sans-serif;">

    <!-- BARRA SUPERIOR / HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" 
              style="-fx-background-color: #B91C1C; -fx-padding: 12 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 6, 0, 0, 2);">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Expreso Bolivariano - Módulos de Operación SOA" 
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Gestión de Disponibilidad, Catálogo de Pasajes y Despacho" 
                       style="-fx-font-size: 11px; -fx-text-fill: #FECACA;"/>
            </VBox>
            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="lblUsuarioActual" text="Usuario: Invitado" 
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #991B1B; -fx-padding: 6 12; -fx-background-radius: 20;"/>
                <Button text="Cerrar Sesión" onAction="#cerrarSesion" 
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #B91C1C; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;"/>
            </HBox>
        </HBox>
    </top>

    <!-- CUERPO PRINCIPAL CON PESTAÑAS (MÓDULOS) -->
    <center>
        <TabPane fx:id="tabPanePrincipal" tabClosingPolicy="UNAVAILABLE" 
                 style="-fx-padding: 10 15 15 15;">

            <!-- ============================================== -->
            <!-- MÓDULO 1: CATÁLOGO Y COMPRA DE TIQUETES       -->
            <!-- ============================================== -->
            <Tab text="Catálogo y Venta de Pasajes">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 8;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Buscar Destino / Pasaje:" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <TextField fx:id="txtBuscarProducto" promptText="Filtrar por ciudad o servicio..." 
                                   prefWidth="280" style="-fx-background-radius: 6; -fx-padding: 6;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="⟳ Actualizar Lista" onAction="#cargarProductos" 
                                style="-fx-background-color: #E5E7EB; -fx-text-fill: #1F2937; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- TABLA DE PRODUCTOS / RUTAS -->
                    <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS" 
                               style="-fx-background-radius: 6; -fx-border-color: #E5E7EB; -fx-border-radius: 6;">
                        <columns>
                            <TableColumn fx:id="colProdId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colProdNombre" text="Ruta / Tipo de Servicio" prefWidth="420"/>
                            <TableColumn fx:id="colProdPrecio" text="Tarifa (COP)" prefWidth="180"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- PANEL DE COMPRA / CHECKOUT -->
                    <HBox spacing="15" alignment="CENTER_LEFT" 
                          style="-fx-background-color: #F9FAFB; -fx-padding: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Pasaje Seleccionado:" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                            <Label fx:id="lblProductoSeleccionado" text="Ninguno seleccionado (haga clic en la tabla)" 
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                        </VBox>

                        <HBox alignment="CENTER" spacing="8">
                            <Label text="Cantidad:" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <Spinner fx:id="spnCantidad" prefWidth="80"/>
                        </HBox>

                        <Button fx:id="btnComprar" text="Realizar Compra / Reserva" onAction="#realizarCompra" 
                                style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="lblEstadoCompra" text="" wrapText="true" 
                           style="-fx-font-size: 12px; -fx-padding: 2 0;"/>
                </VBox>
            </Tab>

            <!-- ============================================== -->
            <!-- MÓDULO 2: HISTORIAL DE COMPRAS / DESPACHO      -->
            <!-- ============================================== -->
            <Tab text="Mis Pasajes e Historial de Compras">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 8;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Filtro de Visualización:" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <RadioButton fx:id="rbSoloMios" text="Solo mis compras" selected="true" 
                                     onAction="#cambiarFiltroCompras"/>
                        <RadioButton fx:id="rbTodasCompras" text="Todas las compras (Visión Despacho)" 
                                     onAction="#cambiarFiltroCompras"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="⟳ Refrescar Compras" onAction="#cargarCompras" 
                                style="-fx-background-color: #E5E7EB; -fx-text-fill: #1F2937; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- TABLA DE COMPRAS -->
                    <TableView fx:id="tblCompras" VBox.vgrow="ALWAYS" 
                               style="-fx-background-radius: 6; -fx-border-color: #E5E7EB; -fx-border-radius: 6;">
                        <columns>
                            <TableColumn fx:id="colCompId" text="ID Compra" prefWidth="90"/>
                            <TableColumn fx:id="colCompUsuario" text="Usuario / Pasajero" prefWidth="180"/>
                            <TableColumn fx:id="colCompProducto" text="Ruta / Tiquete" prefWidth="380"/>
                            <TableColumn fx:id="colCompCantidad" text="Sillas / Pasajes" prefWidth="120"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- RESUMEN OPERACIONAL -->
                    <HBox spacing="20" alignment="CENTER_RIGHT" 
                          style="-fx-background-color: #F3F4F6; -fx-padding: 10 15; -fx-background-radius: 6;">
                        <Label fx:id="lblTotalTransacciones" text="Total Transacciones: 0" 
                               style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <Label fx:id="lblTotalTiquetes" text="Total Tiquetes Emitidos: 0" 
                               style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ============================================== -->
            <!-- MÓDULO 3: GESTIÓN DE INVENTARIO / CATÁLOGO     -->
            <!-- ============================================== -->
            <Tab text="Gestión de Catálogo (Admin)">
                <VBox spacing="15" style="-fx-padding: 18; -fx-background-color: white; -fx-background-radius: 8;">
                    <Label text="Administración de Rutas y Catálogo de Servicios" 
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                    <Label text="Módulo para agregar nuevas rutas o ajustar tarifas en la tabla de productos." 
                           style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>

                    <Separator/>

                    <!-- FORMULARIO NUEVA RUTA -->
                    <GridPane hgap="12" vgap="12" style="-fx-background-color: #F9FAFB; -fx-padding: 15; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" prefWidth="180"/>
                            <ColumnConstraints minWidth="250" prefWidth="380" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Nombre de Ruta / Servicio:" GridPane.rowIndex="0" GridPane.columnIndex="0" 
                               style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <TextField fx:id="txtNuevoNombre" promptText="Ej: Pasaje Bogotá - Armenia (Servicio 2G)" 
                                   GridPane.rowIndex="0" GridPane.columnIndex="1" 
                                   style="-fx-background-radius: 6; -fx-padding: 6;"/>

                        <Label text="Precio / Tarifa (COP):" GridPane.rowIndex="1" GridPane.columnIndex="0" 
                               style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <TextField fx:id="txtNuevoPrecio" promptText="Ej: 65000" 
                                   GridPane.rowIndex="1" GridPane.columnIndex="1" 
                                   style="-fx-background-radius: 6; -fx-padding: 6;"/>

                        <HBox spacing="12" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <Button text="+ Registrar Nuevo Producto" onAction="#agregarNuevoProducto" 
                                    style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;"/>
                            <Button text="🗑 Eliminar Seleccionado del Catálogo" onAction="#eliminarProductoSeleccionado" 
                                    style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 14; -fx-cursor: hand;"/>
                        </HBox>
                    </GridPane>

                    <Label fx:id="lblEstadoAdmin" text="" wrapText="true" 
                           style="-fx-font-size: 12px; -fx-padding: 4 0;"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <!-- PIE DE PÁGINA -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" 
              style="-fx-background-color: #E5E7EB; -fx-padding: 6 15;">
            <Label text="Arquitectura de Software - Politécnico Grancolombiano | Subgrupo 13" 
                   style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Base de Datos: SQLite (tienda.db) [Esquema Intacto]" 
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #047857;"/>
        </HBox>
    </bottom>

</BorderPane>
